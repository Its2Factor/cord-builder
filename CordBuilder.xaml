<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cord Builder" Width="1180" Height="780" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#151515" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Ground" Color="#151515"/>
        <SolidColorBrush x:Key="Surface" Color="#202020"/>
        <SolidColorBrush x:Key="Sunken" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="Separator" Color="#333333"/>
        <SolidColorBrush x:Key="Hairline" Color="#444444"/>
        <SolidColorBrush x:Key="Ink" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="Muted" Color="#98989D"/>
        <SolidColorBrush x:Key="Accent" Color="#0071E3"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0077ED"/>
        <SolidColorBrush x:Key="Link" Color="#4DA3FF"/>
        <SolidColorBrush x:Key="Success" Color="#248A3D"/>
        <SolidColorBrush x:Key="Danger" Color="#FF453A"/>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="#444444"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Background" Value="#444444"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="26,13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" CornerRadius="24" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#3A1D1F"/>
            <Setter Property="Foreground" Value="#FF6961"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" CornerRadius="24" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="#4A2326"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Link}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="TextDecorations" Value="Underline"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Label" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        </Style>

        <!-- Standard Windows caption buttons (Segoe Fluent Icons on Windows 11, MDL2 Assets on Windows 10). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="#2D2D2D"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Background" Value="#383838"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Background" Value="#B22A1D"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="2,6">
                            <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="Foreground" Value="#F5F5F7"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="#F5F5F7"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdatePill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Link}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" Background="#0B2A4A" CornerRadius="13" Padding="12,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="#103A63"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small rotating arc that shows background work is in progress. -->
        <Style x:Key="Spinner" TargetType="Grid">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Client"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="#202020" BorderBrush="#444444" BorderThickness="1" CornerRadius="14" Padding="17">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter/>
                                <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" Stroke="#5E5E5E" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="Fill" Fill="#0071E3" Visibility="Collapsed"/>
                                    <Ellipse x:Name="Pip" Fill="White" Width="7" Height="7" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="#5E5E5E"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="#0B2340"/>
                                <Setter TargetName="Shape" Property="BorderBrush" Value="#0071E3"/>
                                <Setter TargetName="Shape" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Shape" Property="Padding" Value="16"/>
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Pip" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="38" Height="22" Margin="0,0,10,0">
                                <Border x:Name="Track" CornerRadius="11" Background="#333333"/>
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/></Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34C759"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shape" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- The content host already applies the TextBox's Padding; adding it as a margin too doubled the inset. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Shape" Property="Background" Value="#0071E3"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shape" Background="#202020" BorderBrush="#444444" BorderThickness="1" CornerRadius="9" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Foreground="#F5F5F7"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1" Data="M 2,4 L 6,8 L 10,4" Stroke="#8E8E93" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="10" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="#5E5E5E"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="#0071E3"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="#202020" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Margin="0,6,8,8" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14"/></Border.Effect>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border Background="#5E5E5E" CornerRadius="3"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Margin="4,2">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb"><Border Background="#5E5E5E" CornerRadius="3"/></ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusyBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="16" Padding="20,16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="#444444"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource Ground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the whole strip drags the window; controls opt in to clicks. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="TitleLogoImage" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Cord Builder" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Navigation is centred on the whole window, not just the space between the edges. -->
            <StackPanel x:Name="NavPanel" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton x:Name="NavHome" Content="Home" Style="{StaticResource NavTab}" IsChecked="True"/>
                <RadioButton x:Name="NavPlugins" Content="Plugins" Style="{StaticResource NavTab}"/>
                <RadioButton x:Name="NavActivity" Content="Activity" Style="{StaticResource NavTab}"/>
                <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavTab}"/>
            </StackPanel>
            <!-- Replaces the tabs while the setup assistant is open. -->
            <Border x:Name="SetupTag" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                    Background="#262628" CornerRadius="13" Padding="14,4">
                <TextBlock Text="First-time setup" FontSize="12" Foreground="#D1D1D6"/>
            </Border>
            <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource UpdatePill}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="Open the release page">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Link}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateText" Text="Update available"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Height="40">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                <Button x:Name="ZoomButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <TextBlock x:Name="ZoomGlyph" Text="&#xE922;"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- ============ Setup assistant (first run) ============ -->
            <Grid x:Name="AssistantPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,1,0">
                    <DockPanel Margin="28,24,28,24">
                        <StackPanel DockPanel.Dock="Top" Margin="0,4,0,30">
                            <TextBlock Text="First-time setup" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Four steps, about five minutes" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18"
                                   Text="Nothing here needs administrator access. Tools are installed privately for your Windows account."/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Border x:Name="StepToolsBadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#5E5E5E" Margin="0,0,12,0">
                                    <Grid>
                                        <Path x:Name="StepToolsCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/>
                                        <TextBlock x:Name="StepToolsNumber" Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12" Margin="0,0,2,1"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StepToolsLabel" Text="Required tools" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Border x:Name="StepSourceBadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#5E5E5E" Margin="0,0,12,0">
                                    <Grid>
                                        <Path x:Name="StepSourceCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/>
                                        <TextBlock x:Name="StepSourceNumber" Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12" Margin="0,0,2,1"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StepSourceLabel" Text="Source" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Border x:Name="StepBuildBadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#5E5E5E" Margin="0,0,12,0">
                                    <Grid>
                                        <Path x:Name="StepBuildCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/>
                                        <TextBlock x:Name="StepBuildNumber" Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12" Margin="0,0,2,1"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StepBuildLabel" Text="Build" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="StepDiscordBadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#5E5E5E" Margin="0,0,12,0">
                                    <Grid>
                                        <Path x:Name="StepDiscordCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/>
                                        <TextBlock x:Name="StepDiscordNumber" Text="4" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12" Margin="0,0,2,1"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StepDiscordLabel" Text="Install into Discord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel MaxWidth="580" Margin="48,48,48,24" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="20" Background="#0B2A4A" HorizontalAlignment="Center">
                                <Path x:Name="AssistantIcon" Stroke="#4DA3FF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="40" Height="40" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="AssistantTitle" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,8"/>
                            <TextBlock x:Name="AssistantBody" FontSize="15" Foreground="{StaticResource Muted}" TextAlignment="Center"
                                       TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,28"/>

                            <!-- Step 1: tools -->
                            <StackPanel x:Name="ToolsStepPanel">
                                <Border Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="GitDot" Width="8" Height="8" Fill="#5E5E5E" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="Git" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="GitStatus" Grid.Column="2" Text="Checking..." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource Separator}" Margin="16,0"/>
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="NodeDot" Width="8" Height="8" Fill="#5E5E5E" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="Node.js" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="NodeStatus" Grid.Column="2" Text="Checking..." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource Separator}" Margin="16,0"/>
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="PnpmDot" Width="8" Height="8" Fill="#5E5E5E" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="pnpm" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PnpmStatus" Grid.Column="2" Text="Checking..." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button x:Name="InstallPrerequisitesButton" Content="Install missing tools" Style="{StaticResource PrimaryButton}"/>
                                    <!-- Shown instead of the install button once every tool passes, so Continue is the only action. -->
                                    <StackPanel x:Name="ToolsReadyPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Success}" Margin="0,0,10,0">
                                            <Path Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="9" Height="9" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="All three tools work" Foreground="#D1D1D6" FontSize="13.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="AssistantCheckButton" Content="Check again" Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 2: source. The group moves to Settings when that page is open. -->
                            <StackPanel x:Name="SourceStepPanel" Visibility="Collapsed">
                                <ContentControl x:Name="SourceHostAssistant" Focusable="False">
                                    <StackPanel x:Name="SourceGroup">
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="VencordRadio" Style="{StaticResource ClientCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Vencord" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="The original client mod. Strict, reproducible installs." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="EquicordRadio" Grid.Column="2" Style="{StaticResource ClientCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Equicord" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="A Vencord fork with many extra plugins. Needs Node.js LTS." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                        <TextBlock Text="Source folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="ProjectPathBox" AutomationProperties.Name="Source folder"/>
                                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Choose..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="PathHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SourceInfoText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </ContentControl>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <Button x:Name="PrepareButton" Content="Download source &amp; dependencies" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 3: build -->
                            <StackPanel x:Name="BuildStepPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" CornerRadius="14" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock x:Name="AssistantPluginSummary" TextWrapping="Wrap"/>
                                        <Button x:Name="AssistantPluginsButton" Content="Open userplugins folder" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-4,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <Button x:Name="BuildButton" Content="Build" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 4: Discord. The group moves to Settings when that page is open. -->
                            <StackPanel x:Name="DiscordStepPanel" Visibility="Collapsed">
                                <ContentControl x:Name="DiscordHostAssistant" Focusable="False">
                                    <StackPanel x:Name="DiscordGroup">
                                        <TextBlock Text="Discord installation" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="DiscordChannelCombo" Style="{StaticResource SelectBox}" AutomationProperties.Name="Discord installation"/>
                                            <Button x:Name="RescanDiscordButton" Grid.Column="1" Content="Rescan" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                                    ToolTip="Look for newly installed Discord channels"/>
                                        </Grid>
                                        <TextBlock x:Name="DiscordChannelHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ContentControl>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <Button x:Name="InjectButton" Content="Install into Discord" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Progress and recent output while a step runs -->
                            <StackPanel x:Name="AssistantProgressPanel" Visibility="Collapsed" Margin="0,26,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ProgressBar Style="{StaticResource BusyBar}" VerticalAlignment="Center"/>
                                    <Button x:Name="AssistantStopButton" Grid.Column="1" Content="Stop" Style="{StaticResource DangerLinkButton}" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="AssistantElapsedText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border x:Name="AssistantLogPanel" Visibility="Collapsed" Background="{StaticResource Sunken}" CornerRadius="12" Padding="14,10" Margin="0,14,0,0">
                                <TextBlock x:Name="AssistantLogText" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#D1D1D6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0" Padding="28,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="StepCounterText" Text="Step 1 of 4" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Grid Width="140" Height="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Border Background="#333333" CornerRadius="2"/>
                                    <Border x:Name="StepProgressFill" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="35"/>
                                </Grid>
                                <Button x:Name="ShowActivityButton" Content="Show activity" Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ Home ============ -->
            <Grid x:Name="HomePage" Margin="64,24,64,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Ellipse x:Name="HeroDot" Width="8" Height="8" Fill="#5E5E5E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Grid x:Name="HeroSpinner" Style="{StaticResource Spinner}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Stroke="#3A3A3C" StrokeThickness="2"/>
                                <Path Data="M 6,1 A 5,5 0 0 1 11,6" Stroke="{StaticResource Link}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <TextBlock x:Name="HeroEyebrow" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="50" FontWeight="Bold" TextWrapping="Wrap" LineHeight="54"/>
                        <TextBlock x:Name="HeroBody" FontSize="18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="26" MaxWidth="470"
                                   HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        <StackPanel x:Name="HeroProgressPanel" Visibility="Collapsed" Margin="0,22,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <ProgressBar Style="{StaticResource BusyBar}" Width="420"/>
                            <TextBlock x:Name="HeroElapsedText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button x:Name="HeroPrimaryButton" Style="{StaticResource PillButton}"/>
                            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource StopPillButton}" Visibility="Collapsed"/>
                            <Button x:Name="RunAllButton" Content="Run all steps &#x203A;" Style="{StaticResource LinkButton}" FontSize="16" Margin="18,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Update the source, build, and install into Discord in one go"/>
                        </StackPanel>
                        <ContentControl x:Name="DevHostHome" Margin="0,22,0,0" Focusable="False">
                            <StackPanel x:Name="DevModeGroup">
                                <CheckBox x:Name="DevModeCheck" Content="Development build" Style="{StaticResource ToggleSwitch}"/>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                    <!-- The shadow sits on its own layer so the card's text keeps crisp ClearType rendering. -->
                    <Border CornerRadius="22" Background="#202020">
                        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35"/></Border.Effect>
                    </Border>
                    <Border Style="{StaticResource Card}" CornerRadius="22" Padding="28,26,24,6">
                        <StackPanel>
                            <!-- Timeline: tools, source, build, Discord -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border x:Name="ToolsBadge" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="#444444" HorizontalAlignment="Left">
                                    <Grid>
                                        <Path x:Name="ToolsCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                        <Ellipse x:Name="ToolsDot" Width="10" Height="10" Fill="#0071E3" Visibility="Collapsed"/>
                                        <TextBlock x:Name="ToolsBang" Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Rectangle x:Name="ToolsLine" Grid.Row="1" Width="2" Fill="#333333" HorizontalAlignment="Left" Margin="12,4,0,4" MinHeight="18"/>
                                <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="0,2,12,22">
                                    <TextBlock x:Name="ToolsTitle" Text="Tools" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ToolsDetail" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="CheckPrerequisitesButton" Grid.Column="2" Content="Check again" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border x:Name="SourceBadge" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="#444444" HorizontalAlignment="Left">
                                    <Grid>
                                        <Path x:Name="SourceCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                        <Ellipse x:Name="SourceDot" Width="10" Height="10" Fill="#0071E3" Visibility="Collapsed"/>
                                        <TextBlock x:Name="SourceBang" Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Rectangle x:Name="SourceLine" Grid.Row="1" Width="2" Fill="#333333" HorizontalAlignment="Left" Margin="12,4,0,4" MinHeight="18"/>
                                <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="0,2,12,22">
                                    <TextBlock x:Name="SourceTitle" Text="Source" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SourceDetail" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="UpdateSourceButton" Grid.Column="2" Content="Update" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border x:Name="BuildBadge" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="#444444" HorizontalAlignment="Left">
                                    <Grid>
                                        <Path x:Name="BuildCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                        <Ellipse x:Name="BuildDot" Width="10" Height="10" Fill="#0071E3" Visibility="Collapsed"/>
                                        <TextBlock x:Name="BuildBang" Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Rectangle x:Name="BuildLine" Grid.Row="1" Width="2" Fill="#333333" HorizontalAlignment="Left" Margin="12,4,0,4" MinHeight="18"/>
                                <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="0,2,12,22">
                                    <TextBlock x:Name="BuildTitle" Text="Build" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BuildDetail" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="DiscordBadge" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="#444444" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid>
                                        <Path x:Name="DiscordCheck" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                        <Ellipse x:Name="DiscordDot" Width="10" Height="10" Fill="#0071E3" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DiscordBang" Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,2,12,22">
                                    <TextBlock x:Name="DiscordTitle" Text="Discord" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DiscordDetail" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,3,0,0">
                                    <Button x:Name="ReinjectButton" Content="Re-inject" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/>
                                    <Button x:Name="RestoreDiscordButton" Content="Restore stock" Style="{StaticResource DangerLinkButton}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                            ToolTip="Remove the patch and return Discord to its original files"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PluginsTile" Style="{StaticResource TileButton}" AutomationProperties.Name="Plugins">
                        <StackPanel>
                            <TextBlock Text="PLUGINS" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="PluginsTileValue" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="PluginsTileDetail" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiscordTile" Grid.Column="2" Style="{StaticResource TileButton}" AutomationProperties.Name="Discord">
                        <StackPanel>
                            <TextBlock Text="DISCORD" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="DiscordTileValue" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DiscordTileDetail" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BuildTile" Grid.Column="4" Style="{StaticResource TileButton}" AutomationProperties.Name="Last build">
                        <StackPanel>
                            <TextBlock Text="LAST BUILD" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="BuildTileValue" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="BuildTileDetail" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Recent: the last few verified steps. Rows that don't fit a small window are clipped. -->
                <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="16" Padding="22,16,22,8" Margin="0,16,0,0" VerticalAlignment="Top" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="RECENT" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Text}" Foreground="#D1D1D6" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RecentEmptyText" Foreground="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"
                                   Text="Nothing yet. Builds, updates and installs are listed here once they're verified."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Plugins ============ -->
            <Grid x:Name="PluginsPage" Visibility="Collapsed" Margin="64,16,64,22">
                <Grid.Resources>
                    <!-- One row per plugin. Buttons carry a Tag the page's click handler acts on. -->
                    <DataTemplate x:Key="PluginRow">
                        <Border x:Name="Row" Padding="14,9" CornerRadius="10" Margin="0,1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Glyph" Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="#30D158" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                <TextBlock x:Name="Mark" Visibility="Collapsed" FontWeight="Bold" FontSize="14" Width="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NameText" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Reason" Text="{Binding Note}" Foreground="#FF6961" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="Open" Tag="open" Style="{StaticResource LinkButton}" ToolTip="Open in VS Code, or in File Explorer if VS Code isn't installed"/>
                                    <Button Content="Reveal" Tag="reveal" Style="{StaticResource LinkButton}" Margin="6,0,0,0" ToolTip="Show in File Explorer"/>
                                </StackPanel>
                                <TextBlock x:Name="WhenText" Grid.Column="3" Text="{Binding Modified}" Foreground="{StaticResource Muted}" FontSize="12" Width="100" TextAlignment="Right" VerticalAlignment="Center"
                                           ToolTip="Last changed"/>
                                <CheckBox Grid.Column="4" Tag="toggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=OneWay}" Margin="20,0,-10,0" VerticalAlignment="Center"
                                          ToolTip="Include in builds. Off renames the folder with a leading _ so the build skips it; nothing is deleted."
                                          AutomationProperties.Name="{Binding DisplayName}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#29292B"/>
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Note}" Value="">
                                <Setter TargetName="Reason" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Warning">
                                <Setter TargetName="Row" Property="Background" Value="#2A2316"/>
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Mark" Property="Text" Value="!"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="#FFB340"/>
                                <Setter TargetName="Reason" Property="Foreground" Value="#FFB340"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                <Setter TargetName="Row" Property="Background" Value="#3A1D1F"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M 6,6 L 18,18 M 18,6 L 6,18"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#FF453A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Disabled">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Mark" Property="Text" Value="–"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="#5E5E5E"/>
                                <Setter TargetName="NameText" Property="Foreground" Value="#6E6E73"/>
                                <Setter TargetName="WhenText" Property="Foreground" Value="#5E5E5E"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="User plugins" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="PluginsSummary" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PluginsSubtitle" Foreground="#6E6E73" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="240">
                            <TextBox x:Name="PluginSearchBox" AutomationProperties.Name="Search plugins"/>
                            <TextBlock x:Name="PluginSearchHint" Text="Search plugins" Foreground="#6E6E73" IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Button x:Name="OpenPluginsButton" Content="Open folder" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip="Open the userplugins folder"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="16">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="6">
                                <ItemsControl x:Name="PluginList" ItemTemplate="{StaticResource PluginRow}"/>
                                <StackPanel x:Name="DisabledPluginsPanel" Visibility="Collapsed">
                                    <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Margin="8,6,8,0" Padding="6,14,0,6">
                                        <TextBlock Text="DISABLED · SKIPPED BY THE BUILD" Style="{StaticResource Eyebrow}"/>
                                    </Border>
                                    <ItemsControl x:Name="DisabledPluginList" ItemTemplate="{StaticResource PluginRow}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="PluginsEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="380" FontSize="14" LineHeight="21"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Activity ============ -->
            <Grid x:Name="ActivityPage" Visibility="Collapsed" Margin="64,16,64,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Activity" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Live output from Git, Node.js and pnpm. Every session is also saved to a log file." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NextIssueButton" Content="Next issue" Style="{StaticResource SecondaryButton}" ToolTip="Jump to the next error or failure in the output"/>
                        <Button x:Name="CopyLogButton" Content="Copy" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        <Button x:Name="OpenLogFileButton" Content="Open log file" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        <Button x:Name="ClearLogButton" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="16" Padding="4">
                    <Grid>
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#202020"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#D1D1D6" Padding="24,18"
                                 AutomationProperties.Name="Activity log"/>
                        <StackPanel x:Name="LogEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="400">
                            <TextBlock Text="&gt;_" FontFamily="{StaticResource MonoFont}" FontSize="34" Foreground="#3A3A3C" HorizontalAlignment="Center"/>
                            <TextBlock Text="No activity yet" FontSize="15" FontWeight="SemiBold" Foreground="#D1D1D6" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Output from builds, updates and installs shows up here as it happens. Problems are highlighted so you can jump straight to them."
                                       Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Settings ============ -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel MaxWidth="640" Margin="48,16,48,28">
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="CLIENT AND SOURCE" Style="{StaticResource Eyebrow}" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="20">
                        <ContentControl x:Name="SourceHostSettings" Focusable="False"/>
                    </Border>
                    <TextBlock Text="DISCORD" Style="{StaticResource Eyebrow}" Margin="4,24,0,8"/>
                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="20">
                        <ContentControl x:Name="DiscordHostSettings" Focusable="False"/>
                    </Border>
                    <TextBlock Text="BUILD" Style="{StaticResource Eyebrow}" Margin="4,24,0,8"/>
                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <ContentControl x:Name="DevHostSettings" Focusable="False"/>
                            <TextBlock Text="Development builds include extra logging and dev-only plugins. Changing this requires a new build."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="48,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="MAINTENANCE" Style="{StaticResource Eyebrow}" Margin="4,24,0,8"/>
                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="20">
                        <WrapPanel>
                            <Button x:Name="OpenAssistantButton" Content="Open setup assistant" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button x:Name="OpenLogsFolderButton" Content="Open logs folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button x:Name="OpenBackupsFolderButton" Content="Open Discord backups" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <TextBlock x:Name="AppVersionText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,8"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Activity bar: always shows what is happening -->
        <Button x:Name="ActivityBarButton" Grid.Row="2" Cursor="Hand" Foreground="#F5F5F7" AutomationProperties.Name="Activity">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape" Background="#1B1B1B" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="20,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Background" Value="#202020"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#248A3D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LastLogText" Grid.Column="2" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel x:Name="ActivityBusyPanel" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
                    <ProgressBar Style="{StaticResource BusyBar}" Width="90" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ActivityElapsedText" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Path Grid.Column="4" Data="M 2,8 L 6,4 L 10,8" Stroke="#8E8E93" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="12" Height="10" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Button>
    </Grid>
</Window>
